# Variáveis de ambiente - copie este arquivo para .env e preencha os valores

# Servidor
PORT=3000
NODE_ENV=development

# Banco de dados PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nome_do_banco
DB_USER=postgres
DB_PASSWORD=sua_senha_aqui
DB_SSL=false
# TLS com validação do certificado (obrigatório em banco remoto/produção): DB_SSL=true
# CA que assina o certificado do banco (conteúdo PEM com \n escapado, ou caminho do arquivo):
# DB_SSL_CA_FILE=/etc/ssl/certs/rds-global-bundle.pem
# Tamanho máximo do pool de conexões POR INSTÂNCIA (padrão 20)
# DB_POOL_MAX=20

# JWT
JWT_SECRET=troque_por_uma_string_longa_e_aleatoria_aqui
JWT_EXPIRES_IN=8h

# Entrada rápida por PIN em aparelhos autorizados: quantidade de dígitos (2 a 6, padrão 4)
# PIN_TAMANHO=4

# CORS - origens permitidas (separadas por vírgula)
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Fotos: pasta onde as imagens são gravadas (padrão: backend/uploads).
# Use um caminho absoluto para guardar em outra pasta do PC, ex.: D:\\Fotos
STORAGE_DRIVER=local
# UPLOADS_DIR=D:\\Fotos

# Fotos na nuvem (S3 privado ou compatível): STORAGE_DRIVER=s3 e as variáveis abaixo.
# Credenciais: use função IAM da instância/contêiner; AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY só se não houver.
# S3_BUCKET=meu-bucket-de-fotos
# S3_REGION=sa-east-1
# S3_PREFIX=prod
# S3_URL_EXPIRA_SEG=300
# S3_SSE=AES256
# S3_ENDPOINT=https://minio.exemplo.com   (apenas S3 compatível)
# S3_FORCE_PATH_STYLE=true

# Atrás de proxy/balanceador: número de saltos confiáveis (ex.: 1). Evite "true".
# TRUST_PROXY=1
# Documentação Swagger em /docs: padrão ligada fora de produção e desligada em produção
# DOCS_ENABLED=false
# Limite geral de requisições por IP por minuto (padrão 600)
# RATE_LIMIT_POR_MINUTO=600

# Backup (banco + fotos). Padrão: backend/backups
# BACKUP_DIR=D:\\Backup
# Quantidade de backups do banco mantidos
BACKUP_RETENCAO=14
# Backup automático diário (true/false) e horário (HH:MM)
BACKUP_AUTOMATICO=true
BACKUP_HORARIO=22:00
# Caminho do pg_dump (detectado automaticamente no Windows)
# PG_DUMP_PATH=C:\\Program Files\\PostgreSQL\\17\\bin\\pg_dump.exe
