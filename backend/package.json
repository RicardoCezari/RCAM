{
  "name": "azteca-os-backend",
  "version": "1.0.0",
  "description": "Backend da aplicação Azteca OS - Sistema de Ordens de Serviço para Relojoaria",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "lint": "eslint src/",
    "test": "node --test --test-concurrency=1 \"tests/**/*.test.js\"",
    "db:teste": "node scripts/teste-db.js",
    "uploads:s3": "node scripts/migrar-uploads-s3.js",
    "historico:relatorio": "node scripts/historico.js relatorio",
    "historico:exportar": "node scripts/historico.js exportar",
    "seed:carga": "node scripts/seed-carga.js",
    "benchmark": "node scripts/benchmark.js",
    "explain": "node scripts/explain.js",
    "soak": "node scripts/soak.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "@aws-sdk/s3-request-presigner": "^3.1156.0",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.1",
    "express-validator": "^7.2.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.5.0",
    "pg": "^8.12.0",
    "sharp": "^0.35.5",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
